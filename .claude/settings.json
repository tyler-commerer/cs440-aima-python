{
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "0"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "NotebookEdit|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check_vacuum_notebook.py\""
          }
        ]
      }
    ]
  }
}
